{
  "name": "kilo-latex-patch",
  "version": "0.1.0",
  "description": "Unofficial local patch that adds LaTeX math rendering (KaTeX) to the Kilo Desktop chat on Windows, until Kilo-Org/kilo-desktop#70 is fixed.",
  "type": "module",
  "bin": {
    "kilo-latex-patch": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "install.ps1"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-render.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "keywords": [
    "kilo",
    "kilo-desktop",
    "latex",
    "katex",
    "math",
    "patch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuangquyNguyenvo/kilo-latex-patch.git"
  },
  "homepage": "https://github.com/QuangquyNguyenvo/kilo-latex-patch#readme",
  "bugs": {
    "url": "https://github.com/QuangquyNguyenvo/kilo-latex-patch/issues"
  },
  "os": [
    "win32"
  ]
}
